<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="adminPage" value="orders"/>
<c:set var="pageTitle" value="Đơn hàng"/>
<%@ include file="/WEB-INF/views/admin/components/begin.jspf" %>
<main class="admin-content">
    <header class="page-header"><div><h1>Đơn hàng</h1><p>Theo dõi đơn hàng, cập nhật tiến độ và xác nhận thanh toán.</p></div><button type="button" id="refreshBtn" class="button outline">Tải lại dữ liệu</button></header>
    <section class="stats-grid" aria-label="Thống kê đơn hàng">
        <div class="stat-card"><span class="stat-icon"><svg class="icon"><use href="#icon-orders"/></svg></span><div><span class="stat-label">Tổng đơn hàng</span><strong class="stat-num" id="orderTotal"><c:out value="${orderTotal}"/></strong></div></div>
        <div class="stat-card"><span class="stat-icon">◷</span><div><span class="stat-label">Chờ xác nhận</span><strong class="stat-num" id="orderPending"><c:out value="${orderPending}"/></strong></div></div>
        <div class="stat-card"><span class="stat-icon">✓</span><div><span class="stat-label">Hoàn tất</span><strong class="stat-num" id="orderCompleted"><c:out value="${orderCompleted}"/></strong></div></div>
        <div class="stat-card"><span class="stat-icon">↗</span><div><span class="stat-label">Đang xử lý</span><strong class="stat-num" id="orderProcessing"><c:out value="${orderProcessing}"/></strong></div></div>
    </section>
    <div id="adminAlert" class="alert" ${empty sessionScope.adminOrderError and empty sessionScope.adminOrderMessage ? 'hidden' : ''} role="alert"><c:out value="${not empty sessionScope.adminOrderError ? sessionScope.adminOrderError : sessionScope.adminOrderMessage}"/></div><c:remove var="adminOrderError" scope="session"/><c:remove var="adminOrderMessage" scope="session"/>
    <div class="admin-toolbar"><div class="filter-row"><div class="search-field"><input id="orderSearch" type="search" placeholder="Tìm mã đơn, tên hoặc số điện thoại..." aria-label="Tìm đơn hàng"></div><select id="orderStatusFilter" aria-label="Lọc trạng thái"><option value="">Tất cả trạng thái</option><option value="PENDING_CONFIRMATION">Chờ xác nhận</option><option value="PREPARING">Đang chuẩn bị</option><option value="DELIVERING">Đang giao</option><option value="COMPLETED">Hoàn tất</option><option value="CANCELLED">Đã hủy</option></select><select id="orderTypeFilter" aria-label="Lọc hình thức nhận"><option value="">Tất cả hình thức</option><option value="DELIVERY">Giao tận nơi</option><option value="PICKUP">Nhận tại cửa hàng</option></select></div></div>
    <section class="admin-card"><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Thời gian</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thanh toán</th><th>Thao tác</th></tr></thead><tbody id="adminOrderList"><c:forEach var="order" items="${orders}"><tr data-order-row data-order-id="<c:out value='${order.orderId}'/>" data-name="<c:out value='${order.receiverName}'/>" data-phone="<c:out value='${order.receiverPhone}'/>" data-status="${order.status}" data-type="${order.fulfillmentType}">
<td><strong><c:out value="${order.orderId}"/></strong><small>${order.fulfillmentType == 'PICKUP' ? 'Nhận tại cửa hàng' : 'Giao tận nơi'}</small></td><td><strong><c:out value="${not empty order.receiverName ? order.receiverName : 'Khách hàng'}"/></strong><small><c:out value="${order.receiverPhone}"/></small></td><td data-date="${order.orderedAt}"></td><td><strong class="price-text"><fmt:formatNumber value="${order.totalAmount}" groupingUsed="true"/> ₫</strong></td><td data-order-status="${order.status}"></td><td><span data-order-status="${order.payment.status}"></span><small>${order.payment.method == 'CASH' or order.payment.method == 'COD' ? 'Tiền mặt' : 'Chuyển khoản'}</small></td><td><button class="button outline btn-sm" type="button" data-order-id="<c:out value='${order.orderId}'/>">Chi tiết</button></td></tr></c:forEach><tr id="orderEmpty" hidden><td colspan="7" class="empty-state">Không có đơn hàng phù hợp với bộ lọc.</td></tr></tbody></table></div><div class="table-footer"><span id="orderResultCount"></span><div><button class="button outline" id="orderPrev" type="button">Trước</button> <button class="button outline" id="orderNext" type="button">Sau</button></div></div></section>
</main>
<div id="orderDetailModal" data-open="${not empty detailOrder}" data-status="${detailOrder.status}" data-type="${detailOrder.fulfillmentType}" data-payment-status="${detailOrder.payment.status}" class="modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="orderDetailTitle"><div class="modal-dialog modal-lg"><div class="modal-header"><div><h3 id="orderDetailTitle">Đơn hàng <c:out value="${detailOrder.orderId}"/></h3><p id="orderDetailSubtitle" class="text-muted"><span data-date="${detailOrder.orderedAt}"></span> · ${detailOrder.fulfillmentType == 'PICKUP' ? 'Nhận tại cửa hàng' : 'Giao tận nơi'}</p></div><button type="button" class="modal-close" id="closeOrderDetail" aria-label="Đóng chi tiết">×</button></div><div id="orderDetailBody" class="modal-body"><c:if test="${not empty detailOrder}">
<dl class="detail-grid"><div><dt>Người nhận</dt><dd><c:out value="${detailOrder.receiverName}"/></dd></div><div><dt>Số điện thoại</dt><dd><c:out value="${detailOrder.receiverPhone}"/></dd></div><div><dt>Địa chỉ nhận hàng</dt><dd><c:out value="${not empty detailOrder.deliveryAddress ? detailOrder.deliveryAddress : 'Nhận tại cửa hàng'}"/></dd></div><div><dt>Ghi chú</dt><dd><c:out value="${not empty detailOrder.customerNote ? detailOrder.customerNote : 'Không có ghi chú'}"/></dd></div></dl>
<div class="table-responsive"><table class="admin-table-sub"><thead><tr><th>Món ăn</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="item" items="${detailOrder.items}"><tr><td><strong><c:out value="${not empty item.foodNameSnapshot ? item.foodNameSnapshot : item.foodName}"/></strong><small><c:forEach var="option" items="${item.options}" varStatus="loop"><c:out value="${option.optionName}"/>${not loop.last ? ', ' : ''}</c:forEach></small><c:if test="${not empty item.note}"><small><c:out value="${item.note}"/></small></c:if></td><td>${item.quantity}</td><td><fmt:formatNumber value="${item.lineTotal}" groupingUsed="true"/> ₫</td></tr></c:forEach></tbody></table></div>
<dl class="detail-grid" style="margin-top:18px"><div><dt>Tạm tính</dt><dd><fmt:formatNumber value="${detailOrder.subtotal}" groupingUsed="true"/> ₫</dd></div><div><dt>Giảm giá</dt><dd><fmt:formatNumber value="${detailOrder.discountAmount}" groupingUsed="true"/> ₫</dd></div><div><dt>Phí giao hàng</dt><dd><fmt:formatNumber value="${detailOrder.deliveryFee}" groupingUsed="true"/> ₫</dd></div><div><dt>Thanh toán</dt><dd><span data-order-status="${detailOrder.payment.status}"></span> · ${detailOrder.payment.method == 'CASH' or detailOrder.payment.method == 'COD' ? 'Tiền mặt' : 'Chuyển khoản'}</dd></div></dl>
<div class="order-detail-total"><span>Tổng cộng</span><strong><fmt:formatNumber value="${detailOrder.totalAmount}" groupingUsed="true"/> ₫</strong></div><h4>Tiến độ đơn hàng <span data-order-status="${detailOrder.status}"></span></h4>
<form method="post" action="<c:url value='/admin/orders/action'/>" class="order-status-control" style="display:none" id="orderStatusForm" hidden><input type="hidden" name="orderId" value="<c:out value='${detailOrder.orderId}'/>"><input type="hidden" name="note" value="Nhân viên cập nhật qua trang quản trị"><select id="detailOrderStatus" name="status" aria-label="Trạng thái đơn mới"></select><button type="submit" class="button primary" id="saveOrderStatus">Cập nhật đơn</button></form><p class="text-muted" id="orderFinished" hidden>Đơn hàng đã kết thúc.</p>
<c:if test="${not empty detailOrder.payment}"><form method="post" action="<c:url value='/admin/orders/payment'/>" class="order-status-control" style="display:none" id="paymentStatusForm" hidden><input type="hidden" name="orderId" value="<c:out value='${detailOrder.orderId}'/>"><input type="hidden" name="paymentId" value="<c:out value='${detailOrder.payment.paymentId}'/>"><input type="hidden" name="transactionRef" value="ADMIN"><select id="detailPaymentStatus" name="status" aria-label="Trạng thái thanh toán mới"></select><button type="submit" class="button outline" id="savePaymentStatus">Cập nhật thanh toán</button></form></c:if>
<h4 style="margin-top:24px">Lịch sử xử lý</h4><div class="history-list"><c:forEach var="entry" items="${detailOrder.history}"><p><span data-status-label="${entry.status}"></span><time data-date="${entry.changedAt}"></time><c:out value="${entry.note}"/></p></c:forEach><c:if test="${empty detailOrder.history}"><p>Chưa có lịch sử.</p></c:if></div>
</c:if></div><div class="modal-footer"><button class="button outline" id="closeOrderDetailFooter" type="button">Đóng</button></div></div></div>
<script src="<c:url value='/assets/js/admin-orders.js?v=20261017-forms1'/>"></script>
<%@ include file="/WEB-INF/views/admin/components/end.jspf" %>
