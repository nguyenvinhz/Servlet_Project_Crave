# Copy this file to .env for Docker Compose. Never commit the real .env file.
MYSQL_ROOT_PASSWORD=Mysql@2026
CRAVE_DB_USER=crave_app
CRAVE_DB_PASSWORD=Mysql@2026

# Shared demo store origin. Replace the coordinates with the exact entrance pin for real deliveries.
# Docker/Tomcat must receive these as environment variables (or JVM -D properties).
CRAVE_STORE_ADDRESS=99 Đường Số 9, Dĩ An, Hồ Chí Minh 825030, Việt Nam
CRAVE_STORE_LATITUDE=10.8925871
CRAVE_STORE_LONGITUDE=106.7637161
# Photon GeoJSON endpoint for checkout address lookup.
CRAVE_GEOCODER_URL=https://photon.komoot.io/api/

# payOS credentials belong only on the server. Fill these in your local .env.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Include the application's context path; update when deploying a public URL.
PAYOS_PUBLIC_BASE_URL=http://localhost:8081/crave

# Email verification uses Gmail SMTP with a Google app password; never commit the password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=craveshopvn@gmail.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=craveshopvn@gmail.com
EMAIL_SMTP_STARTTLS=true
# Generate at least 32 random characters; keep the same value across app restarts.
EMAIL_OTP_SECRET=

# Optional: packaged WAR on Tomcat with `docker compose --profile production up -d`.
CRAVE_HTTP_PORT=8080
CRAVE_TOMCAT_IMAGE=tomcat:10.1-jdk17-temurin
