# Copy this file to .env for Docker Compose. Never commit the real .env file.
MYSQL_ROOT_PASSWORD=Mysql@2026
CRAVE_DB_USER=crave_app
CRAVE_DB_PASSWORD=Mysql@2026

# Bank transfers via PayOS. Supply real values only in ignored .env or production secrets.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PUBLIC_BASE_URL=http://localhost:8080/crave
# Optional full callback URLs; otherwise the base URL above is used.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
