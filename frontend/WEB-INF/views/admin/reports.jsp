<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/><c:set var="adminPage" value="reports"/><c:set var="pageTitle" value="Báo cáo - Thống kê"/>
<%@ include file="/WEB-INF/views/admin/components/begin.jspf" %>
<main class="admin-content"><header class="page-header"><div><h1>Báo cáo - Thống kê</h1><p>Phân tích doanh thu và hiệu quả bán hàng theo thời gian.</p></div><a class="button outline" href="<c:url value='/admin/reports'><c:param name='from' value='${from}'/><c:param name='to' value='${to}'/><c:param name='download' value='csv'/></c:url>">Xuất CSV</a></header>
<form method="get" action="<c:url value='/admin/reports'/>" class="admin-toolbar report-filters"><label for="report-from">Từ ngày</label><input name="from" id="report-from" type="date" required value="${from}"><label for="report-to">Đến ngày</label><input name="to" id="report-to" type="date" required value="${to}"><button class="button primary">Xem báo cáo</button><a href="<c:url value='/admin/reports'><c:param name='days' value='7'/></c:url>">7 ngày</a><a href="<c:url value='/admin/reports'><c:param name='days' value='30'/></c:url>">30 ngày</a><a href="<c:url value='/admin/reports'><c:param name='days' value='90'/></c:url>">90 ngày</a></form>
<section class="stats-grid"><div class="stat-card"><div><span class="stat-label">Doanh thu đã thanh toán</span><strong class="stat-num"><fmt:formatNumber value="${summary.revenue}"/> ₫</strong></div></div><div class="stat-card"><div><span class="stat-label">Tổng đơn hàng</span><strong class="stat-num">${summary.totalOrders}</strong></div></div><div class="stat-card"><div><span class="stat-label">Đơn hoàn tất</span><strong class="stat-num">${summary.completedOrders}</strong></div></div><div class="stat-card"><div><span class="stat-label">Giá trị đơn trung bình</span><strong class="stat-num"><fmt:formatNumber value="${summary.averageOrderValue}"/> ₫</strong></div></div></section>
<section class="admin-card"><div class="card-header"><h2>Biểu đồ doanh thu</h2><span>${from} — ${to}</span></div><div class="card-body"><%@ include file="/WEB-INF/views/admin/components/chart.jspf" %></div></section>
<section class="admin-card table-responsive"><div class="card-header"><h2>Doanh thu theo ngày</h2></div><table class="admin-table"><thead><tr><th>Ngày</th><th>Số đơn hàng</th><th>Doanh thu đã thanh toán</th></tr></thead><tbody><c:forEach var="day" items="${daily}"><tr><td><c:out value="${day.date}"/></td><td>${day.orderCount}</td><td><fmt:formatNumber value="${day.revenue}"/> ₫</td></tr></c:forEach></tbody></table></section>
<section class="admin-card table-responsive"><div class="card-header"><h2>Món ăn bán chạy</h2></div><table class="admin-table"><thead><tr><th>Món ăn</th><th>Số lượng bán</th><th>Giá trị món đã bán</th></tr></thead><tbody><c:forEach var="item" items="${topItems}"><tr><td><c:out value="${item.name}"/></td><td>${item.quantity}</td><td><fmt:formatNumber value="${item.revenue}"/> ₫</td></tr></c:forEach><c:if test="${empty topItems}"><tr><td colspan="3">Chưa có món bán được trong kỳ.</td></tr></c:if></tbody></table></section><p class="report-note">Doanh thu gồm đơn hoàn tất và thanh toán thành công. Giá trị món đã bán tính trước giảm giá và phí giao hàng.</p></main>
<%@ include file="/WEB-INF/views/admin/components/end.jspf" %>
