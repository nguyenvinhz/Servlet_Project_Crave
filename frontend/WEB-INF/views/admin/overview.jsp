<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/><c:set var="adminPage" value="overview"/><c:set var="pageTitle" value="Tổng quan"/>
<%@ include file="/WEB-INF/views/admin/components/begin.jspf" %>
<main class="admin-content"><header class="page-header"><div><h1>Tổng quan</h1><p>Tình hình kinh doanh trong 7 ngày gần đây.</p></div><a class="button outline" href="<c:url value='/admin/reports'/>">Xem báo cáo</a></header>
<%@ include file="/WEB-INF/views/admin/components/feedback.jspf" %>
<section class="stats-grid"><div class="stat-card"><span class="stat-icon">₫</span><div><span class="stat-label">Doanh thu đã thanh toán</span><strong class="stat-num"><fmt:formatNumber value="${summary.revenue}"/> ₫</strong></div></div><div class="stat-card"><div><span class="stat-label">Đơn hàng trong kỳ</span><strong class="stat-num">${summary.totalOrders}</strong></div></div><div class="stat-card"><div><span class="stat-label">Tổng khách hàng</span><strong class="stat-num">${summary.totalCustomers}</strong></div></div><div class="stat-card"><div><span class="stat-label">Đơn chờ xác nhận</span><strong class="stat-num">${summary.pendingOrders}</strong></div></div></section>
<div class="dashboard-grid"><section class="admin-card"><div class="card-header"><h2>Doanh thu theo ngày</h2><span class="text-muted">${from} — ${to}</span></div><div class="card-body"><%@ include file="/WEB-INF/views/admin/components/chart.jspf" %></div></section><section class="admin-card"><div class="card-header"><h2>Đơn hàng theo trạng thái</h2></div><div class="card-body status-breakdown"><c:forEach var="entry" items="${statusCounts}"><div class="status-line"><span><c:out value="${adminLabels[entry.key]}"/></span><strong>${entry.value}</strong><div class="status-bar"><span style="width:${summary.totalOrders > 0 ? entry.value * 100 / summary.totalOrders : 0}%;background:#e8552b"></span></div></div></c:forEach></div></section></div>
<div class="dashboard-grid"><section class="admin-card"><div class="card-header"><h2>Đơn hàng gần đây</h2><a href="<c:url value='/admin/orders'/>">Xem tất cả</a></div><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="order" items="${recentOrders}"><tr><td><a href="<c:url value='/admin/orders'/>"><c:out value="${order.orderId}"/></a></td><td><c:out value="${order.receiverName}"/></td><td><fmt:formatNumber value="${order.totalAmount}"/> ₫</td><td><c:out value="${adminLabels[order.status.toString()]}"/></td></tr></c:forEach><c:if test="${empty recentOrders}"><tr><td colspan="4">Chưa có đơn hàng trong kỳ.</td></tr></c:if></tbody></table></section><section class="admin-card"><div class="card-header"><h2>Món bán chạy</h2></div><div class="card-body"><c:forEach var="item" items="${topItems}" varStatus="index"><div class="top-item"><span class="item-rank">${index.count}</span><div class="item-info"><strong><c:out value="${item.name}"/></strong><small>${item.quantity} phần đã bán</small></div><strong><fmt:formatNumber value="${item.revenue}"/> ₫</strong></div></c:forEach><c:if test="${empty topItems}"><p>Chưa có món bán được trong kỳ.</p></c:if></div></section></div><p class="report-note">Doanh thu gồm đơn hoàn tất và thanh toán thành công; không gồm đơn hủy hoặc đã hoàn tiền.</p></main>
<%@ include file="/WEB-INF/views/admin/components/end.jspf" %>
