<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="adminPage" value="overview"/>
<c:set var="pageTitle" value="Tổng quan"/>
<%@ include file="/WEB-INF/views/admin/components/begin.jspf" %>
<main class="admin-content">
    <header class="page-header"><div><h1>Tổng quan</h1><p>Tình hình kinh doanh và các đơn hàng cần chú ý trong 7 ngày gần đây.</p></div><a class="button outline" href="<c:url value='/admin/reports'/>">Xem báo cáo</a></header>
    <div id="dashboardAlert" class="alert" hidden role="alert"></div>
    <section class="stats-grid">
        <div class="stat-card"><span class="stat-icon">₫</span><div><span class="stat-label">Doanh thu đã thanh toán</span><strong class="stat-num" id="summaryRevenue"><fmt:formatNumber value="${report.summary.revenue}" groupingUsed="true"/> ₫</strong></div></div>
        <div class="stat-card"><span class="stat-icon"><svg class="icon"><use href="#icon-orders"/></svg></span><div><span class="stat-label">Đơn hàng trong kỳ</span><strong class="stat-num" id="summaryOrders"><fmt:formatNumber value="${report.summary.totalOrders}" groupingUsed="true"/></strong></div></div>
        <div class="stat-card"><span class="stat-icon"><svg class="icon"><use href="#icon-users"/></svg></span><div><span class="stat-label">Tổng khách hàng</span><strong class="stat-num" id="summaryCustomers"><fmt:formatNumber value="${report.summary.totalCustomers}" groupingUsed="true"/></strong></div></div>
        <div class="stat-card"><span class="stat-icon">◷</span><div><span class="stat-label">Đơn hàng đang xử lý</span><strong class="stat-num" id="summaryPending"><fmt:formatNumber value="${report.summary.pendingOrders}" groupingUsed="true"/></strong></div></div>
    </section>
    <div class="dashboard-grid"><section class="admin-card"><div class="card-header"><h2>Doanh thu theo ngày</h2><span id="chartRange" class="text-muted"><span data-date="${report.range.from}"></span> – <span data-date="${report.range.to}"></span></span></div><div class="card-body"><div class="revenue-chart" id="revenueChart" aria-label="Biểu đồ doanh thu theo ngày"></div></div></section><section class="admin-card"><div class="card-header"><h2>Đơn hàng theo trạng thái</h2></div><div class="card-body"><div class="status-breakdown" id="statusBreakdown"><c:forEach var="entry" items="${report.statusCounts}"><div class="status-line" data-status-line data-status="${entry.key}" data-count="${entry.value}" data-total="${report.summary.totalOrders}"><span data-status-label></span><strong><c:out value="${entry.value}"/> <span class="text-muted" data-percent></span></strong><div class="status-bar"><span></span></div></div></c:forEach></div></div></section></div>
    <div class="dashboard-grid"><section class="admin-card"><div class="card-header"><h2>Đơn hàng gần đây</h2><a href="<c:url value='/admin/orders'/>">Xem tất cả →</a></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead><tbody id="recentOrders"><c:forEach var="order" items="${report.recentOrders}"><tr><td><a href="<c:url value='/admin/orders'/>"><strong><c:out value="${order.orderId}"/></strong></a><small data-date="${order.orderedAt}" data-time></small></td><td><c:out value="${order.receiverName}"/></td><td><fmt:formatNumber value="${order.totalAmount}" groupingUsed="true"/> ₫</td><td data-order-status="${order.status}"></td></tr></c:forEach><c:if test="${empty report.recentOrders}"><tr><td colspan="4" class="empty-state">Chưa có đơn hàng trong kỳ.</td></tr></c:if></tbody></table></div></section><section class="admin-card"><div class="card-header"><h2>Món ăn bán chạy nhất</h2></div><div class="card-body" id="topItems"><c:forEach var="item" items="${report.topItems}" end="4" varStatus="loop"><div class="top-item"><span class="item-rank">${loop.count}</span><div class="item-info"><strong><c:out value="${item.name}"/></strong><small>${item.quantity} phần đã bán</small></div><div class="item-total"><strong><fmt:formatNumber value="${item.revenue}" groupingUsed="true"/> ₫</strong><small>Giá trị món</small></div></div></c:forEach><c:if test="${empty report.topItems}"><div class="empty-state">Chưa có món ăn bán được trong kỳ.</div></c:if></div></section></div>
    <p class="report-note">Doanh thu gồm đơn đã hoàn tất và thanh toán thành công; không gồm đơn hủy hoặc đã hoàn tiền.</p>
<div id="dashboardData" hidden><c:forEach var="day" items="${report.daily}"><span data-daily data-date="<c:out value='${day.date}'/>" data-order-count="${day.orderCount}" data-revenue="${day.revenue}"></span></c:forEach></div>
</main>
<script src="<c:url value='/assets/js/admin-dashboard.js?v=20261017-forms1'/>"></script>
<%@ include file="/WEB-INF/views/admin/components/end.jspf" %>
