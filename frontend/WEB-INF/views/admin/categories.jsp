<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="adminPage" value="categories"/><c:set var="pageTitle" value="Danh mục"/>
<%@ include file="/WEB-INF/views/admin/components/begin.jspf" %>
<main class="admin-content page-container admin-page"><header class="admin-header"><div><h1>Danh mục</h1><p class="lead">Sắp xếp thực đơn theo nhóm món ăn và thức uống.</p></div><a class="button outline" href="<c:url value='/admin/menu'/>">Quản lý món ăn</a></header>
<%@ include file="/WEB-INF/views/admin/components/feedback.jspf" %>
<section class="admin-card table-responsive"><table class="admin-table"><thead><tr><th>Mã</th><th>Tên danh mục</th><th>Mô tả</th><th>Số món</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="cat" items="${categories}"><tr><td><c:out value="${cat.id}"/></td><td><c:out value="${cat.name}"/></td><td><c:out value="${cat.description}"/></td><td><a href="<c:url value='/admin/menu'><c:param name='categoryId' value='${cat.id}'/></c:url>"><c:out value="${cat.foodCount}"/> món</a></td><td><div class="row-actions"><a class="button outline" href="<c:url value='/admin/categories'><c:param name='edit' value='${cat.id}'/></c:url>#category-form">Sửa</a><form method="post" action="<c:url value='/admin/categories'/>" data-confirm="Xóa danh mục này?"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${cat.id}'/>"><button class="action-btn delete-btn">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty categories}"><tr><td colspan="5">Chưa có danh mục.</td></tr></c:if></tbody></table></section>
<section class="admin-card" id="category-form"><div class="card-header"><h2>${empty editingCategory ? 'Thêm danh mục' : 'Sửa danh mục'}</h2></div><form method="post" action="<c:url value='/admin/categories'/>" class="card-body management-form"><input type="hidden" name="action" value="${empty editingCategory ? 'create' : 'update'}"><input type="hidden" name="id" value="<c:out value='${editingCategory.id}'/>"><div class="form-group"><label for="category-name">Tên danh mục</label><input id="category-name" name="name" maxlength="100" required value="<c:out value='${editingCategory.name}'/>"></div><div class="form-group"><label for="category-description">Mô tả</label><textarea id="category-description" name="description" maxlength="500"><c:out value="${editingCategory.description}"/></textarea></div><button class="button primary">Lưu danh mục</button><c:if test="${not empty editingCategory}"><a class="button outline" href="<c:url value='/admin/categories'/>">Hủy sửa</a></c:if></form></section></main>
<%@ include file="/WEB-INF/views/admin/components/end.jspf" %>
