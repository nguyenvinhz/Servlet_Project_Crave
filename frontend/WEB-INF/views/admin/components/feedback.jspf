<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty adminMessage}"><p class="alert alert-success" role="status"><c:out value="${adminMessage}"/></p></c:if>
<c:if test="${not empty adminError}"><p class="alert alert-error" role="alert"><c:out value="${adminError}"/></p></c:if>
<c:set var="adminLabels" value="${{'ADMIN':'Quản trị viên','HR_MANAGER':'Quản lý nhân sự','MENU_MANAGER':'Quản lý thực đơn','ORDER_STAFF':'Xử lý đơn hàng','PROMOTION_MANAGER':'Quản lý khuyến mãi','ACTIVE':'Hoạt động','LOCKED':'Đã khóa','WORKING':'Đang làm việc','ON_LEAVE':'Đã nghỉ việc','INACTIVE':'Tạm ngưng','AVAILABLE':'Đang bán','UNAVAILABLE':'Tạm hết','PENDING_CONFIRMATION':'Chờ xác nhận','PREPARING':'Đang chuẩn bị','DELIVERING':'Đang giao','COMPLETED':'Hoàn tất','CANCELLED':'Đã hủy','PENDING':'Chờ thanh toán','SUCCESS':'Đã thanh toán','FAILED':'Thanh toán thất bại','REFUNDED':'Đã hoàn tiền','CASH':'Tiền mặt','BANK_TRANSFER':'Chuyển khoản','E_WALLET':'Ví điện tử','PICKUP':'Nhận tại quán','DELIVERY':'Giao tận nơi','SIZE':'Kích cỡ','TOPPING':'Topping','SUGAR_LEVEL':'Mức đường','ICE_LEVEL':'Mức đá','OTHER':'Khác'}}"/>
