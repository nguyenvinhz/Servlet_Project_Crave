<%@ page pageEncoding="UTF-8" %>
<div class="revenue-chart"><svg viewBox="0 0 700 240" role="img" aria-label="Doanh thu theo ngày"><line x1="45" x2="680" y1="200" y2="200" stroke="#ddd"/><c:forEach var="day" items="${daily}" varStatus="index"><c:set var="barHeight" value="${maximumRevenue > 0 ? day.revenue * 170 / maximumRevenue : 0}"/><rect x="${45 + index.index * 630 / daily.size()}" y="${200 - barHeight}" width="${630 / daily.size() * 0.75}" height="${barHeight}" fill="#e8552b"><title><c:out value="${day.date}"/>: <fmt:formatNumber value="${day.revenue}"/> ₫ · ${day.orderCount} đơn</title></rect><c:if test="${index.first or index.last or daily.size() <= 7}"><text class="chart-axis" text-anchor="middle" x="${45 + (index.index + 0.4) * 630 / daily.size()}" y="225"><c:out value="${day.date}"/></text></c:if></c:forEach></svg></div>
