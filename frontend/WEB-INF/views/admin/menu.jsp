<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="adminPage" value="menu"/><c:set var="pageTitle" value="Món ăn - Thức uống"/>
<%@ include file="/WEB-INF/views/admin/components/begin.jspf" %>
<main class="admin-content page-container admin-page">
<header class="admin-header"><div><h1>Món ăn - Thức uống</h1><p class="lead">Quản lý thực đơn, giá bán và tùy chọn cho từng món.</p></div><a class="button outline" href="<c:url value='/admin/categories'/>">Quản lý danh mục</a></header>
<%@ include file="/WEB-INF/views/admin/components/feedback.jspf" %>
<form method="get" class="admin-toolbar admin-filter-form" action="<c:url value='/admin/menu'/>">
<input name="keyword" value="<c:out value='${param.keyword}'/>" placeholder="Tìm tên món" aria-label="Tìm tên món">
<select name="categoryId" aria-label="Danh mục"><option value="">Tất cả danh mục</option><c:forEach var="cat" items="${categories}"><option value="<c:out value='${cat.id}'/>" ${param.categoryId == cat.id ? 'selected' : ''}><c:out value="${cat.name}"/></option></c:forEach></select>
<select name="status" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option><option value="AVAILABLE" ${param.status == 'AVAILABLE' ? 'selected' : ''}>Đang bán</option><option value="UNAVAILABLE" ${param.status == 'UNAVAILABLE' ? 'selected' : ''}>Tạm hết</option></select><button class="button primary">Lọc</button><a href="<c:url value='/admin/menu'/>" class="button outline">Đặt lại</a></form>
<section class="admin-card"><div class="table-responsive"><table class="admin-table"><thead><tr><th>Ảnh</th><th>Món ăn</th><th>Danh mục</th><th>Giá</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="food" items="${foods}"><tr><td><img class="admin-thumb" alt="<c:out value='${food.name}'/>" src="<c:out value='${empty food.imageUrl ? pageContext.request.contextPath.concat("/assets/images/food-placeholder.svg") : food.imageUrl}'/>"></td><td><strong><c:out value="${food.name}"/></strong><small class="text-muted"><c:out value="${food.id}"/></small><p><c:out value="${food.description}"/></p></td><td><c:out value="${food.categoryName}"/></td><td><fmt:formatNumber value="${food.price}"/> ₫</td>
<td><form method="post" action="<c:url value='/admin/menu'/>"><input type="hidden" name="action" value="status"><input type="hidden" name="id" value="<c:out value='${food.id}'/>"><input type="hidden" name="status" value="${food.status == 'AVAILABLE' ? 'UNAVAILABLE' : 'AVAILABLE'}"><button class="status-toggle-btn ${food.status == 'AVAILABLE' ? 'btn-status-available' : 'btn-status-unavailable'}"><c:out value="${adminLabels[food.status.toString()]}"/></button></form></td>
<td><div class="row-actions"><a class="button outline" href="<c:url value='/admin/menu'><c:param name='edit' value='${food.id}'/></c:url>#food-form">Sửa</a><a class="button outline" href="<c:url value='/admin/menu'><c:param name='foodId' value='${food.id}'/></c:url>#options">Tùy chọn</a><form method="post" action="<c:url value='/admin/menu'/>" data-confirm="Xóa món ăn này?"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${food.id}'/>"><button class="action-btn delete-btn">Xóa</button></form></div></td></tr></c:forEach>
<c:if test="${empty foods}"><tr><td colspan="6" class="text-center">Không tìm thấy món ăn.</td></tr></c:if>
</tbody></table></div></section>
<section class="admin-card" id="food-form"><div class="card-header"><h2>${empty editingFood ? 'Thêm món mới' : 'Sửa món ăn'}</h2></div><form method="post" action="<c:url value='/admin/menu'/>" class="card-body management-form"><input type="hidden" name="action" value="${empty editingFood ? 'create' : 'update'}"><input type="hidden" name="id" value="<c:out value='${editingFood.id}'/>">
<div class="form-group"><label for="food-category">Danh mục</label><select id="food-category" name="categoryId" required><c:forEach var="cat" items="${categories}"><option value="<c:out value='${cat.id}'/>" ${editingFood.categoryId == cat.id ? 'selected' : ''}><c:out value="${cat.name}"/></option></c:forEach></select></div>
<div class="form-group"><label for="food-name">Tên món</label><input id="food-name" name="name" value="<c:out value='${editingFood.name}'/>" required maxlength="150"></div>
<div class="form-row"><div class="form-group"><label for="food-price">Giá (đ)</label><input id="food-price" name="price" type="number" min="1000" step="1000" value="<c:out value='${editingFood.price}'/>" required></div><div class="form-group"><label for="food-status">Trạng thái</label><select id="food-status" name="status"><option value="AVAILABLE" ${editingFood.status == 'AVAILABLE' ? 'selected' : ''}>Đang bán</option><option value="UNAVAILABLE" ${editingFood.status == 'UNAVAILABLE' ? 'selected' : ''}>Tạm hết</option></select></div></div>
<div class="form-group"><label for="food-image">Đường dẫn ảnh</label><input id="food-image" name="imageUrl" type="url" maxlength="512" value="<c:out value='${editingFood.imageUrl}'/>"></div>
<div class="form-group"><label for="food-description">Mô tả</label><textarea id="food-description" name="description" maxlength="500"><c:out value="${editingFood.description}"/></textarea></div><button class="button primary">Lưu món ăn</button><c:if test="${not empty editingFood}"><a class="button outline" href="<c:url value='/admin/menu'/>">Hủy sửa</a></c:if></form></section>
<c:if test="${not empty optionFood}"><section class="admin-card" id="options"><div class="card-header"><h2>Tùy chọn: <c:out value="${optionFood.name}"/></h2></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Loại</th><th>Tên</th><th>Phụ thu</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="option" items="${optionFood.options}"><tr><td><c:out value="${adminLabels[option.optionType.toString()]}"/></td><td><c:out value="${option.name}"/></td><td><fmt:formatNumber value="${option.extraPrice}"/> ₫</td><td><form method="post" action="<c:url value='/admin/menu'/>"><input type="hidden" name="action" value="optionStatus"><input type="hidden" name="foodId" value="<c:out value='${optionFood.id}'/>"><input type="hidden" name="id" value="<c:out value='${option.id}'/>"><input type="hidden" name="status" value="${option.status == 'ACTIVE' ? 'INACTIVE' : 'ACTIVE'}"><button class="button outline"><c:out value="${adminLabels[option.status.toString()]}"/></button></form></td><td><div class="row-actions"><a class="button outline" href="<c:url value='/admin/menu'><c:param name='foodId' value='${optionFood.id}'/><c:param name='optionId' value='${option.id}'/></c:url>#option-form">Sửa</a><form method="post" action="<c:url value='/admin/menu'/>" data-confirm="Xóa tùy chọn này?"><input type="hidden" name="action" value="optionDelete"><input type="hidden" name="id" value="<c:out value='${option.id}'/>"><input type="hidden" name="foodId" value="<c:out value='${optionFood.id}'/>"><button class="action-btn delete-btn">Xóa</button></form></div></td></tr></c:forEach>
<c:if test="${empty optionFood.options}"><tr><td colspan="5">Chưa có tùy chọn.</td></tr></c:if></tbody></table></div>
<form method="post" action="<c:url value='/admin/menu'/>" class="card-body management-form" id="option-form"><h3>${empty editingOption ? 'Thêm tùy chọn' : 'Sửa tùy chọn'}</h3><input type="hidden" name="action" value="${empty editingOption ? 'optionCreate' : 'optionUpdate'}"><input type="hidden" name="foodId" value="<c:out value='${optionFood.id}'/>"><input type="hidden" name="id" value="<c:out value='${editingOption.id}'/>">
<div class="form-group"><label for="option-type">Loại</label><select name="optionType" id="option-type"><c:forEach var="type" items="${optionTypes}"><option value="${type}" ${editingOption.optionType == type ? 'selected' : ''}><c:out value="${adminLabels[type.toString()]}"/></option></c:forEach></select></div>
<div class="form-group"><label for="option-name">Tên tùy chọn</label><input id="option-name" name="name" required maxlength="100" value="<c:out value='${editingOption.name}'/>"></div><div class="form-group"><label for="option-price">Phụ thu (đ)</label><input id="option-price" name="extraPrice" type="number" min="0" step="1000" required value="<c:out value='${empty editingOption ? 0 : editingOption.extraPrice}'/>"></div><div class="form-group"><label for="option-status">Trạng thái</label><select name="status" id="option-status"><option value="ACTIVE" ${editingOption.status == 'ACTIVE' ? 'selected' : ''}>Hoạt động</option><option value="INACTIVE" ${editingOption.status == 'INACTIVE' ? 'selected' : ''}>Tạm ngưng</option></select></div><button class="button primary">Lưu tùy chọn</button></form></section></c:if>
</main><%@ include file="/WEB-INF/views/admin/components/end.jspf" %>
