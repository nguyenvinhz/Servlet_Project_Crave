<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'Món ngon mỗi ngày' : pageTitle}"/> · crave.</title>
    <link rel="stylesheet" href="<c:url value='/assets/css/fonts.css'/>">
    <link rel="stylesheet" href="<c:url value='/assets/css/styles.css'/>">
    <link rel="stylesheet" href="<c:url value='/assets/css/customer.css'/>">
    <c:if test="${not empty pageStyle}">
        <link rel="stylesheet" href="<c:url value='/assets/css/${pageStyle}.css'/>">
    </c:if>
    <script>window.CONTEXT_PATH = '${pageContext.request.contextPath}';</script>
</head>
<body class="crave-body ${pageBodyClass}" data-context-path="<c:out value='${pageContext.request.contextPath}'/>" data-account-type="<c:out value='${sessionScope.currentUser.accountType}'/>">
<header class="site-header">
    <div class="site-header-inner">
        <a class="brand" href="<c:url value='/menu'/>">crave<span>.</span></a>
        <nav class="main-nav" aria-label="Điều hướng chính">
            <a href="<c:url value='/menu'/>" class="${pageTitle == 'Thực đơn' ? 'active' : ''}">Thực đơn</a>
            <a href="<c:url value='/promotions'/>" class="${pageTitle == 'Ưu đãi & Khuyến mãi' ? 'active' : ''}">Khuyến mãi</a>
            <c:if test="${sessionScope.currentUser.accountType != 'EMPLOYEE'}">
                <a href="<c:url value='/cart'/>" class="${pageTitle == 'Giỏ hàng của bạn' ? 'active' : ''}">Giỏ hàng</a>
            </c:if>
            <c:if test="${sessionScope.currentUser.accountType == 'CUSTOMER'}">
                <a href="<c:url value='/orders'/>" class="${pageTitle == 'Đơn hàng của bạn' ? 'active' : ''}">Đơn hàng</a>
            </c:if>
            <c:if test="${sessionScope.currentUser.role == 'ADMIN' or sessionScope.currentUser.role == 'MENU_MANAGER'}">
                <a href="<c:url value='/admin/menu'/>" class="${pageTitle == 'Quản lý thực đơn' ? 'active' : ''}">Quản lý món</a>
                <a href="<c:url value='/admin/categories'/>" class="${pageTitle == 'Quản lý danh mục' ? 'active' : ''}">Quản lý danh mục</a>
            </c:if>
            <c:if test="${sessionScope.currentUser.role == 'ADMIN' or sessionScope.currentUser.role == 'ORDER_STAFF'}">
                <a href="<c:url value='/admin/orders'/>">Quản lý đơn hàng</a>
            </c:if>
        </nav>
        <div class="header-actions header-actions-right">
            <c:if test="${sessionScope.currentUser.accountType == 'EMPLOYEE'}">
                <a href="<c:url value='/admin'/>" class="header-login-link">Trang quản trị</a>
            </c:if>
            <c:if test="${sessionScope.currentUser.accountType != 'EMPLOYEE'}">
            <a href="<c:url value='/cart'/>" class="header-cart-icon-btn" title="Giỏ hàng" aria-label="Giỏ hàng">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span class="cart-badge-count">0</span>
            </a>
            </c:if>
            <c:choose>
                <c:when test="${not empty sessionScope.currentUser}">
                    <a href="<c:url value='/customer/profile'/>" class="header-login-link">Hồ sơ</a>
                    <c:if test="${sessionScope.currentUser.accountType == 'CUSTOMER'}">
                        <a href="<c:url value='/customer/addresses'/>" class="header-login-link">Địa chỉ</a>
                    </c:if>
                    <form id="logoutForm" class="logout-form" action="<c:url value='/api/auth/logout'/>" method="post">
                        <button class="nav-button" type="submit">Đăng xuất</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <a href="<c:url value='/auth/login'/>" class="header-login-link">Đăng nhập</a>
                    <a href="<c:url value='/auth/register'/>" class="header-login-link">Đăng ký</a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
<p id="logout-error" class="form-error header-message" role="alert" hidden></p>
<noscript><p class="header-message">Vui lòng bật JavaScript để sử dụng chức năng tài khoản.</p></noscript>
